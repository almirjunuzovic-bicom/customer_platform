# For docker-compose.dev.yml (local MySQL + Redis) only - separate from
# apps/api/.env. Copy to .env and fill in real values. Never commit .env
# (see .gitignore).
#
# If you're instead setting up the shared staging VM pair, see the
# "Appendix: shared staging environment" section of ONBOARDING.md - it
# uses docker-compose.yml (a different file) with different vars.

# Must match DB_PASSWORD in apps/api/.env exactly.
# Generate with: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Must match REDIS_PASSWORD in apps/api/.env exactly.
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=
