# For docker-compose.yml (Redis) only - separate from apps/api/.env.
# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# This machine's own private IP - Redis binds here + 127.0.0.1 only, never
# 0.0.0.0 (see docker-compose.yml comment: network_mode: host is required
# on SERVERware VMs, which means no container-level network isolation).
PRIVATE_IP=

# Must match REDIS_PASSWORD in apps/api/.env exactly.
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=
