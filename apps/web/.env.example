# Copy to .env.local. Correct as-is for local dev - the API runs on your
# own laptop too (see ONBOARDING.md), no tunnel needed. If you're instead
# viewing the shared staging VM's frontend via an SSH tunnel (see the
# "Appendix: shared staging environment" section of ONBOARDING.md), this
# still points at the tunneled localhost port, not the VM's private IP
# directly - your browser can't reach that network.
VITE_API_BASE_URL=http://localhost:3001
