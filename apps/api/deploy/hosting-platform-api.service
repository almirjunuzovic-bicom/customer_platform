[Unit]
Description=Hosting Platform - read-only API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=almir
WorkingDirectory=/opt/hosting-platform/apps/api
EnvironmentFile=/opt/hosting-platform/apps/api/.env
ExecStart=/usr/bin/node dist/api.js
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# NoNewPrivileges intentionally NOT set here (unlike the worker service) -
# OpsController shells out to `sudo systemctl restart ...` (see ops/
# ops.controller.ts), and NoNewPrivileges blocks any setuid escalation
# (sudo is setuid root), no exceptions. `almir` already has passwordless
# root sudo on this VM regardless, so this isn't opening a new privilege
# boundary, just letting this one process use the one it already has.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
