# Copy to .env and fill in real values. Never commit .env (see .gitignore).
DB_HOST=192.168.20.5
DB_PORT=3306
DB_USER=hosting_app
DB_PASSWORD=
DB_NAME=hosting_platform

# Sources (SERVERware clusters, later AWS/Proxmox) are no longer configured
# via env vars - they're DB rows, added with:
#   pnpm add:source --key lon1 --name "UK Lon1" --connector-type serverware \
#     --config '{"baseUrl":"...","netId":1}' --credentials '{"apiToken":"..."}'
# See src/connectors/add-source.manual.ts and hst2171-architecture.

# Encrypts source credentials at rest (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Needed by both api and worker (anything that calls SourcesService).
CREDENTIALS_ENCRYPTION_KEY=

REDIS_HOST=192.168.20.4
REDIS_PORT=6379
REDIS_PASSWORD=

# Bound to the private IP ONLY - no auth on the network level yet either way,
# must not be internet-reachable
API_HOST=192.168.20.4
API_PORT=3001

# Generate with: openssl rand -base64 48
JWT_SECRET=
